# ==========================================
# 함평콕(hampyeong-kok) 환경 변수 설정 템플릿
# ==========================================

# 1. 네이버 클라우드 플랫폼 Maps Client ID (필수, 브라우저 공개 가능)
# NCP 콘솔 > Maps > Application > [인증 정보] > Client ID (X-NCP-APIGW-API-KEY-ID)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=your_client_id_here

# 2. 네이버 클라우드 플랫폼 Maps Client Secret (서버/스크립트 전용, 비공개)
# NCP 콘솔 > Maps > Application > [인증 정보] > Client Secret (X-NCP-APIGW-API-KEY)
# 주소 좌표 변환(Geocoding) 배치 스크립트 실행 시 사용됩니다.
NAVER_MAP_CLIENT_SECRET=your_client_secret_here

# 3. 사이트 기본 URL (카카오톡/SNS 링크 공유 및 메타태그용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
